NODE_ENV=development

# Postgres (letto dal container postgres di docker-compose.yml)
POSTGRES_USER=malcesine
POSTGRES_PASSWORD=malcesine
POSTGRES_DB=malcesine

# Database — deve corrispondere alle tre variabili POSTGRES_* qui sopra
# quando ti connetti dall'host (pnpm dev, db:push) invece che da dentro compose
DATABASE_URL=postgresql://malcesine:malcesine@localhost:5432/malcesine

# API
API_PORT=4001

# Web (Vue SPA)
WEB_PORT=4301
VITE_API_URL=http://localhost:4001

# Logger microservice
LOGGER_PORT=4201
LOGGER_URL=http://localhost:4201
LOGGER_DATA_DIR=./data/logs
# LOGGER_FLUSH_INTERVAL_MS=300000  # default 5 minuti

# Cron — scraper meteo (ogni minuto di default)
SCRAPE_SCHEDULE=* * * * *

# Holfuy — 1000 = stazione "Decollo Malcesine" (holfuy.com/en/data/1000)
HOLFUY_STATION_ID=1000

# Addicted Sport — pid 248, "Malcesine tempo metereologico"
ADDICTED_SPORT_URL=https://it.addicted-sports.com/webcam/gardasee/malcesine/

# Redis — cache delle letture (finestra scorrevole 24h), archiviata su file dal cron.
# Non ancora nel percorso live delle API, solo archiviazione per elaborazioni future.
REDIS_URL=redis://localhost:6379
ARCHIVE_SCHEDULE=5 0 * * *
READINGS_ARCHIVE_DIR=./data/readings
