NODE_ENV=development

# Database (condiviso da tutte le app)
DATABASE_URL=postgresql://malcesine:malcesine@localhost:5432/malcesine

# API
API_PORT=4001

# Web (Vue SPA)
WEB_PORT=4301
VITE_API_URL=http://localhost:4001

# Logger microservice
LOGGER_PORT=4201
LOGGER_URL=http://localhost:4201
LOGGER_DATA_DIR=./data/logs
# LOGGER_FLUSH_INTERVAL_MS=300000  # default 5 minuti

# Cron — scraper meteo (ogni minuto di default)
SCRAPE_SCHEDULE=* * * * *

# Holfuy — 1000 = stazione "Decollo Malcesine" (holfuy.com/en/data/1000)
HOLFUY_STATION_ID=1000

# Addicted Sport — non ancora implementato, vedi apps/cron/src/scrapers/addictedSport.ts
# ADDICTED_SPORT_URL=
