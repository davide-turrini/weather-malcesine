{
  "name": "@malcesine/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "with-env vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check src/",
    "fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@malcesine/with-env": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.4.5",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
