{
  "name": "@malcesine/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "with-env tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "with-env node dist/index.js",
    "lint": "biome check src/",
    "fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@malcesine/banner": "workspace:*",
    "@malcesine/db": "workspace:*",
    "@malcesine/env": "workspace:*",
    "@malcesine/heartbeat": "workspace:*",
    "@malcesine/logger": "workspace:*",
    "fastify": "^5.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@malcesine/with-env": "workspace:*",
    "drizzle-kit": "^0.22.0",
    "vitest": "^4.1.6"
  }
}
